<?xml version="1.0" encoding="UTF-8"?>
<Patch>
    <!-- Add archotech Skipdoors to Ancient Complex loot tables -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingSetMakerDef[defName="MapGen_AncientComplexRoomLoot_Default"]/root/options</xpath>
        <value>
            <li>
                <weight>0.03</weight>
                <thingSetMaker Class="ThingSetMaker_Count">
                    <fixedParams>
                    <countRange>1~2</countRange>
                    <filter>
                        <thingDefs>
                        <li>ArchotechSkipdoor</li>
                        </thingDefs>
                    </filter>
                    </fixedParams>
                </thingSetMaker>
            </li>
        </value>
    </Operation>

    <!-- Give caravans the ability to Recall to a skipgate if they have a skip beacon -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/WorldObjectDef[defName="Caravan"]/comps</xpath>
        <match Class="PatchOperationAdd">
            <xpath>Defs/WorldObjectDef[defName="Caravan"]/comps</xpath>
            <value>
                <li Class="MigCorp.Skiptech.Skipgate.WorldObjectCompProperties_SkipBeaconRecall" />
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/WorldObjectDef[defName="Caravan"]</xpath>
            <value>
                <comps>
                    <li Class="MigCorp.Skiptech.Skipgate.WorldObjectCompProperties_SkipBeaconRecall" />
                </comps>
            </value>
        </nomatch>
    </Operation>

    <!-- Add skip beacons to trader stock -->
    <Operation Class="PatchOperationAdd">
    <xpath>Defs/TraderKindDef[defName="Caravan_Outlander_Exotic" or defName="Orbital_Exotic" or defName="Base_Outlander_Standard"]/stockGenerators
    </xpath>
    <value>
        <li Class="StockGenerator_SingleDef">
            <thingDef>MigCorp_SkipBeacon</thingDef>
            <countRange>0~2</countRange>
        </li>
    </value>
</Operation>
</Patch>
