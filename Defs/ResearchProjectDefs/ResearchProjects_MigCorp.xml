<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <ResearchTabDef>
        <defName>MigCorp</defName>
        <label>MigCorp</label>
        <generalTitle>MigCorp research</generalTitle>
        <generalDescription>Research into MigCorp technologies.</generalDescription>
    </ResearchTabDef>


    <ResearchProjectDef>
        <defName>MigCorp_SkipNet</defName>
        <label>SkipNet</label>
        <description>Develop localized skipfields capable of briefly folding nearby space, allowing compatible skipdoors to act as shortcuts through otherwise traversable space.</description>

        <baseCost>2000</baseCost>
        <techLevel>Spacer</techLevel>
        <tab>MigCorp</tab>

        <prerequisites>
            <li>Fabrication</li>
        </prerequisites>

        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>

        <researchViewX>1</researchViewX>
        <researchViewY>1</researchViewY>
    </ResearchProjectDef>


    <ResearchProjectDef>
        <defName>MigCorp_SkipField</defName>
        <label>SkipField</label>
        <description>[Under Development - Not yet available]\nLong distance skipping with Skipgates.</description>

        <baseCost>2500</baseCost>
        <techLevel>Spacer</techLevel>
        <tab>MigCorp</tab>

        <prerequisites>
            <li>Fabrication</li>
        </prerequisites>

        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>

        <researchViewX>1</researchViewX>
        <researchViewY>2.5</researchViewY>

        <customUnlockTexts>
            <li>Enables Skipgate Send operations.</li>
            <li>Skipgate capacitors can safely hold up to 150 charge.</li>
        </customUnlockTexts>
    </ResearchProjectDef>


    <ResearchProjectDef>
        <defName>MigCorp_SkipVoid</defName>
        <label>SkipVoid</label>
        <description>[Under Development - Not yet available]\nPull distant targets to Skipgates with skip beacons.</description>

        <baseCost>3500</baseCost>
        <techLevel>Spacer</techLevel>
        <tab>MigCorp</tab>

        <prerequisites>
            <li>MigCorp_SkipField</li>
        </prerequisites>

        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>

        <researchViewX>2.5</researchViewX>
        <researchViewY>2.5</researchViewY>

        <customUnlockTexts>
			<li>Enables Skipgate Recall operations.</li>
            <li>Increases Skipgate capacitor safe capacity to 400 charge.</li>
        </customUnlockTexts>
    </ResearchProjectDef>


    <ResearchProjectDef>
        <defName>MigCorp_SkipRift</defName>
        <label>SkipRift</label>
        <description>[Under Development - Not yet available]\nSkipgate-to-skipgate linking.</description>

        <baseCost>5000</baseCost>
        <techLevel>Spacer</techLevel>
        <tab>MigCorp</tab>

        <prerequisites>
            <li>MigCorp_SkipVoid</li>
            <li>AdvancedFabrication</li>
        </prerequisites>

        <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>

        <researchViewX>4</researchViewX>
        <researchViewY>2.5</researchViewY>

        <customUnlockTexts>
            <li>Enables persistent Skipgate Links.</li>
            <li>Removes the Skipgate capacitor safe capacity limit.</li>
        </customUnlockTexts>
    </ResearchProjectDef>
</Defs>