<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
	<MigCorp.Skiptech.Settings>MigCorp - Skiptech</MigCorp.Skiptech.Settings>
	<!-- Gameplay Settings -->
	<MigCorp.Skiptech.Settings.Allowed>Skipdoor Access Mode:</MigCorp.Skiptech.Settings.Allowed>

	<MigCorp.Skiptech.Settings.Allowed.Everyone>Everyone</MigCorp.Skiptech.Settings.Allowed.Everyone>
	<MigCorp.Skiptech.Settings.Allowed.Everyone.Tip>Anyone can use skipdoors</MigCorp.Skiptech.Settings.Allowed.Everyone.Tip>
	<MigCorp.Skiptech.Settings.Allowed.NonHostile>Non-Hostile</MigCorp.Skiptech.Settings.Allowed.NonHostile>
	<MigCorp.Skiptech.Settings.Allowed.NonHostile.Tip>Only pawns not hostile to your colonists can use skipdoors</MigCorp.Skiptech.Settings.Allowed.NonHostile.Tip>
	<MigCorp.Skiptech.Settings.Allowed.Colonists>Colonists</MigCorp.Skiptech.Settings.Allowed.Colonists>
	<MigCorp.Skiptech.Settings.Allowed.Colonists.Tip>Only your colonists can use skipdoors</MigCorp.Skiptech.Settings.Allowed.Colonists.Tip>

	<MigCorp.Skiptech.Settings.Allowed.Animals>Allow Animals</MigCorp.Skiptech.Settings.Allowed.Animals>
	<MigCorp.Skiptech.Settings.Allowed.Animals.Tip>Animals can use skipdoors</MigCorp.Skiptech.Settings.Allowed.Animals.Tip>

	<MigCorp.Skiptech.Settings.Features.DisableUnpoweredSkipdoors>Disable Unpowered Skipdoors</MigCorp.Skiptech.Settings.Features.DisableUnpoweredSkipdoors>
	<MigCorp.Skiptech.Settings.Features.DisableUnpoweredSkipdoors.Tip>Pawns will not use unpowered skipdoors. This applies to all pawns and basically disables skip-shock too.</MigCorp.Skiptech.Settings.Features.DisableUnpoweredSkipdoors.Tip>

	<MigCorp.Skiptech.Settings.Features.Skipshock>Disable Skip-Shock</MigCorp.Skiptech.Settings.Features.Skipshock>
	<MigCorp.Skiptech.Settings.Features.Skipshock.Tip>Prevents pawns from getting skip-shock when using unpowered skipdoors</MigCorp.Skiptech.Settings.Features.Skipshock.Tip>

	<MigCorp.Skiptech.Settings.Features.SkipshockAvoidance>Enable Skip-Shock Avoidance</MigCorp.Skiptech.Settings.Features.SkipshockAvoidance>
	<MigCorp.Skiptech.Settings.Features.SkipshockAvoidance.Tip>Pawns will avoid using skipdoors that cause skip-shock unless they are drafted or performing a forced action</MigCorp.Skiptech.Settings.Features.SkipshockAvoidance.Tip>

	<MigCorp.Skiptech.Settings.Power.Default>Skipdoor power consumption (default): {0} W</MigCorp.Skiptech.Settings.Power.Default>
	<MigCorp.Skiptech.Settings.Power.Default.Tip>Default skipdoor power draw for new games and for saves that haven't been customized. Reset returns to the mod's built-in value ({0} W).</MigCorp.Skiptech.Settings.Power.Default.Tip>
	<MigCorp.Skiptech.Settings.Power.Game>Skipdoor power consumption (current game): {0} W</MigCorp.Skiptech.Settings.Power.Game>
	<MigCorp.Skiptech.Settings.Power.Game.Tip>Power draw for all skipdoors in the current game. Applies immediately to every existing and future skipdoor. Reset to follow the mod default ({0} W).</MigCorp.Skiptech.Settings.Power.Game.Tip>
	<MigCorp.Skiptech.Settings.Power.Reset>Reset to default</MigCorp.Skiptech.Settings.Power.Reset>

	<!-- Advanced pathtuning settings -->
	<MigCorp.Skiptech.Settings.SkipNetTuning>Pathfinding Tuning (Advanced):</MigCorp.Skiptech.Settings.SkipNetTuning>
	<MigCorp.Skiptech.Settings.SkipNetTuning.SkipCost>Skip cost: {0} ticks</MigCorp.Skiptech.Settings.SkipNetTuning.SkipCost>
	<MigCorp.Skiptech.Settings.SkipNetTuning.SkipCost.Tip>Flat travel-time cost (in ticks) added to any route that uses a skipdoor pair. Higher values make pawns skip the skipdoors on short trips. Default: 60.</MigCorp.Skiptech.Settings.SkipNetTuning.SkipCost.Tip>

	<MigCorp.Skiptech.Settings.SkipNetTuning.WorthItFactor>Improvement requirement: {0}</MigCorp.Skiptech.Settings.SkipNetTuning.WorthItFactor>
	<MigCorp.Skiptech.Settings.SkipNetTuning.WorthItFactor.Tip>How much better a skipdoor route must be to replace the direct path. At 85%, the walk to the entry plus the walk from the exit must total at most 85% of the direct path. Lower = pickier pawns, fewer teleports. Default: 85%.</MigCorp.Skiptech.Settings.SkipNetTuning.WorthItFactor.Tip>
	
	<!-- Accessibility Settings -->
	<MigCorp.Skiptech.Settings.Accessibility.FlashEffect>Disable teleport visuals</MigCorp.Skiptech.Settings.Accessibility.FlashEffect>
	<MigCorp.Skiptech.Settings.Accessibility.FlashEffect.Tip>Turns off the teleport-flash visual effect</MigCorp.Skiptech.Settings.Accessibility.FlashEffect.Tip>

	<!-- Debug Settings -->
	<MigCorp.Skiptech.Settings.Debug>DEBUG</MigCorp.Skiptech.Settings.Debug>
	<MigCorp.Skiptech.Settings.Debug.Enable>Enable Dev Mode to access debug settings.</MigCorp.Skiptech.Settings.Debug.Enable>
	<MigCorp.Skiptech.Settings.Debug.Verbose>Verbose Logging</MigCorp.Skiptech.Settings.Debug.Verbose>
	
	<!-- General Text-->
